# Copy this file to infra/samconfig.toml and replace GitHubAppId/allowlists.
# Never place secrets or private keys in this file.
version = 0.1

[default.global.parameters]
region = "us-east-1"

[default.validate.parameters]
template_file = "infra/template.yaml"
lint = true

[default.build.parameters]
template_file = "infra/template.yaml"
cached = true
parallel = true
beta_features = true

[default.deploy.parameters]
template_file = ".aws-sam/build/template.yaml"
stack_name = "arcus-dev"
resolve_s3 = true
s3_prefix = "arcus-dev"
region = "us-east-1"
confirm_changeset = true
fail_on_empty_changeset = false
capabilities = "CAPABILITY_NAMED_IAM"
parameter_overrides = "Environment=dev BedrockModelId=us.amazon.nova-2-lite-v1:0 BedrockFoundationModelId=amazon.nova-2-lite-v1:0 GitHubAppId=123456 AllowedRepositories=* AllowedInstallationIds=* ReviewsPerRepositoryDay=10 ReviewsPerInstallationHour=5"

[demo.global.parameters]
region = "us-east-1"

[demo.validate.parameters]
template_file = "infra/template.yaml"
lint = true

[demo.build.parameters]
template_file = "infra/template.yaml"
cached = true
parallel = true
beta_features = true

[demo.deploy.parameters]
template_file = ".aws-sam/build/template.yaml"
stack_name = "arcus-demo"
resolve_s3 = true
s3_prefix = "arcus-demo"
region = "us-east-1"
confirm_changeset = true
fail_on_empty_changeset = false
capabilities = "CAPABILITY_NAMED_IAM"
parameter_overrides = "Environment=demo BedrockModelId=us.amazon.nova-2-lite-v1:0 BedrockFoundationModelId=amazon.nova-2-lite-v1:0 GitHubAppId=123456 AllowedRepositories=* AllowedInstallationIds=* ReviewsPerRepositoryDay=30 ReviewsPerInstallationHour=5"
