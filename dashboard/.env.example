# The dashboard is a pure read-only client of the deployed Arcus backend.
# VITE_API_BASE_URL is the DashboardApiUrl output from infra/template.yaml
# (e.g. https://{api-id}.execute-api.{region}.amazonaws.com).
# VITE_API_KEY must match the value stored in the arcus-{env}-dashboard-api-key secret.
VITE_API_BASE_URL=
VITE_API_KEY=

# Display-only values; the deployed backend is the source of truth.
VITE_ARCUS_AWS_REGION=us-east-1
VITE_ARCUS_BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0

# Public slug of the GitHub App (from its settings page URL), used only to
# build a link to GitHub's own installation/consent screen. Not a secret.
VITE_GITHUB_APP_SLUG=
