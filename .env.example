# Arcus local development configuration. Never commit credentials or private keys.
ARCUS_ENV=dev
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
S3_ARTIFACT_BUCKET=arcus-dev-context-artifacts
DDB_REVIEW_TABLE=arcus-dev-review-history
STATE_MACHINE_ARN=
WEBHOOK_SECRET_ARN=
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY_SECRET_ARN=
GITHUB_API_BASE_URL=https://api.github.com
ALLOWED_REPOSITORIES=*
ALLOWED_INSTALLATION_IDS=*
REVIEWS_PER_REPOSITORY_DAY=10
REVIEWS_PER_INSTALLATION_HOUR=5
ADMISSION_TTL_SECONDS=7776000
MAX_WEBHOOK_BODY_BYTES=1048576
SECRET_CACHE_TTL_SECONDS=300
MAX_OUTPUT_TOKENS=2400
MAX_PROMPT_BYTES=60000
MAX_FINDINGS_PER_STAGE=10
MAX_FINDINGS_TOTAL=10
MAX_CHANGED_FILES=50
MAX_DIFF_BYTES=524288
MAX_ENVELOPE_BYTES=240000
MAX_AI_OPERATIONS_PER_RUN=3
DASHBOARD_API_KEY_SECRET_ARN=

# Dashboard login (GitHub OAuth) -- see infra/README.md "Configure dashboard login"
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET_ARN=
SESSION_SECRET_ARN=
DASHBOARD_BASE_URL=
OAUTH_REDIRECT_URI=
SESSION_TTL_SECONDS=43200

# AWS_PROFILE is a local CLI setting, not a deployed Lambda setting.
# AWS_PROFILE=arcus-hackathon
